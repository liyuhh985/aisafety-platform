# 复制此文件为 application-local.yml，仅填写本地开发凭据。
# 不要将真实密码、Token 或密钥提交到 Git。

spring:
  datasource:
    url: jdbc:mysql://${DB_HOST:127.0.0.1}:${DB_PORT:3306}/safety_platform?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: ${DB_USER:root}
    password: ${DB_PASSWORD:}
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
      database: ${REDIS_DB:2}
  mail:
    host: ${MAIL_HOST:smtp.163.com}
    port: ${MAIL_PORT:465}
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}

minio:
  endpoint: ${MINIO_ENDPOINT:http://127.0.0.1:9000}
  access-key: ${MINIO_ACCESS_KEY:}
  secret-key: ${MINIO_SECRET_KEY:}
  bucket: ${MINIO_BUCKET:safety-images}
  base-url: ${MINIO_BASE_URL:http://127.0.0.1:9000}

ai:
  base-url: ${AI_BASE_URL:http://127.0.0.1:8000/api/ai}
  internal-token: ${AI_INTERNAL_TOKEN:replace-with-a-high-entropy-secret}

vector-sync:
  delete:
    poll-delay-ms: ${VECTOR_SYNC_DELETE_POLL_DELAY_MS:30000}
    batch-size: ${VECTOR_SYNC_DELETE_BATCH_SIZE:50}
