# OpenDesign OpenAI-compatible endpoint (text + vision)
VISION_PROVIDER=opendesign
OPENDESIGN_BASE_URL=https://amr-link.open-design.ai/v1
OPENDESIGN_API_KEY=sk-your-opendesign-key
OPENDESIGN_VISION_MODEL=deepseek-v4.1-flash

# Text and small-model slots. LLM_SMALL_* inherits LLM_TEXT_* when omitted.
LLM_TEXT_PROVIDER=opendesign
LLM_TEXT_BASE_URL=https://amr-link.open-design.ai/v1
LLM_TEXT_API_KEY=sk-your-opendesign-key
LLM_TEXT_MODEL=deepseek-v4.1-flash

# SiliconFlow Embedding (free)
SF_API_KEY=sk-your-siliconflow-key

# Shared secret for Java-to-Python internal API calls
AI_INTERNAL_TOKEN=replace-with-a-high-entropy-secret

# 槽位证据模式：off=旧逻辑 / shadow=只记录审计 / enforce=证据参与判定。
# 默认 shadow；先观察影子日志，稳定后再切 enforce。
SLOT_EVIDENCE_MODE=shadow

# 单机默认只监听 127.0.0.1；容器内网部署可显式改为 0.0.0.0，但不得映射公网端口
AI_BIND_HOST=127.0.0.1
AI_BIND_PORT=8000
AI_CORS_ORIGINS=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=safety_platform

# Vector retrieval. Keep MySQL during migration until Milvus is synchronized and smoke-tested.
VECTOR_BACKEND=mysql
MILVUS_ENABLED=false
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_ALIAS=safety_platform
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_EMBEDDING_DIM=1024
MILVUS_TIMEOUT_SECONDS=5
MILVUS_FALLBACK_TO_MYSQL=true
MILVUS_CASE_COLLECTION=hazard_cases
MILVUS_POLICY_COLLECTION=hazard_policies
MILVUS_REGULATION_COLLECTION=hazard_regulations

# 向量检索最低置信度（COSINE 相似度）。低于此值的命中直接视为不相关。
RETRIEVAL_MIN_SCORE=0.48
