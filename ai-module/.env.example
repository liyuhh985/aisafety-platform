# MiMo API (vision model)
MIMO_API_KEY=sk-your-mimo-key

# SiliconFlow Embedding (free)
SF_API_KEY=sk-your-siliconflow-key

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=safety_platform

# Vector retrieval. Keep MySQL during migration until Milvus is synchronized and smoke-tested.
VECTOR_BACKEND=mysql
MILVUS_ENABLED=false
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_ALIAS=safety_platform
MILVUS_EMBEDDING_DIM=1024
MILVUS_TIMEOUT_SECONDS=5
MILVUS_FALLBACK_TO_MYSQL=true
MILVUS_CASE_COLLECTION=hazard_cases
MILVUS_POLICY_COLLECTION=hazard_policies
MILVUS_REGULATION_COLLECTION=hazard_regulations

# Required only by docker-compose.milvus.yml. Keep real values in the local .env file.
MILVUS_MINIO_USER=
MILVUS_MINIO_PASSWORD=
